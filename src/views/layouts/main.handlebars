<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-light d-flex flex-column min-vh-100">

    <!-- Barra de navegación destacada y sticky -->
    <header class="sticky-top shadow-sm border-bottom bg-dark" data-bs-theme="dark">
        <nav class="container navbar navbar-expand-md py-2 py-md-3">
            <!-- Brand con isotipo estilizado -->
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold tracking-tight text-white m-0" href="/">
                <span class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-3 fs-6 px-2 py-1 shadow-sm">
                    M6
                </span>
                <span>ABP Panel</span>
            </a>

            <!-- Botón Hamburguesa accesible para móviles -->
            <button class="navbar-toggler border-0 p-2 text-white-50" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" aria-controls="navMenu" aria-expanded="false" aria-label="Abrir menú">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Menú colapsable / responsive -->
            <div class="collapse navbar-collapse mt-3 mt-md-0" id="navMenu">
                <ul class="navbar-nav ms-auto align-items-stretch align-items-md-center gap-1 gap-md-2">
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded-3 text-secondary text-hover-white" href="/">
                            Inicio
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded-3 text-secondary text-hover-white d-flex align-items-center gap-2" href="/status">
                            <span>Estado</span>
                            <!-- Indicador de pulso/salud -->
                            <span class="d-inline-block rounded-circle bg-success" style="width: 8px; height: 8px;"></span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded-3 text-secondary text-hover-white" href="/usuarios">
                            Usuarios
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    <!-- Contenido principal flexible -->
    <main class="container py-4 py-md-5 flex-grow-1">
        {{{body}}}
    </main>

    <!-- Footer fijo al fondo si hay poco contenido -->
    <footer class="border-top bg-white py-3 py-md-4 mt-auto">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 text-secondary small">
            <p class="mb-0">© 2026 Proyecto Backend - Alkemy</p>
            <span class="badge bg-light text-secondary border">v1.0.0</span>
        </div>
    </footer>

    <!-- Bootstrap JS indispensable para el menú colapsable en celular -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>

</html>