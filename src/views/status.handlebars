<!-- Encabezado de página -->
<section class="d-flex flex-wrap justify-content-between align-items-center gap-3 pb-3 mb-4 border-bottom">
  <div>
    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 mb-2 fw-medium">
      Monitoreo
    </span>
    <h1 class="h2 fw-bold tracking-tight mb-1 text-dark">{{title}}</h1>
    <p class="text-secondary small mb-0">Métricas operativas del servidor en tiempo real.</p>
  </div>
  <a href="/status" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2 shadow-sm">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-arrow-clockwise" viewBox="0 0 16 16">
      <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z"/>
      <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466"/>
    </svg>
    Actualizar
  </a>
</section>

<!-- Tarjetas de métricas responsivas -->
<div class="row g-3 g-md-4">
  <!-- Estado del Servidor -->
  <div class="col-12 col-md-4">
    <div class="card border-0 shadow-sm rounded-4 h-100">
      <div class="card-body p-3 p-sm-4 d-flex flex-column justify-content-between">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <span class="text-secondary small fw-medium">Estado</span>
          <span class="p-2 rounded-3 bg-success-subtle text-success d-inline-flex">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-activity" viewBox="0 0 16 16">
              <path fill-rule="evenodd" d="M6 2a.5.5 0 0 1 .47.33L10 12.036l1.53-4.593A.5.5 0 0 1 12 7h3.5a.5.5 0 0 1 0 1h-3.162l-1.808 5.426a.5.5 0 0 1-.948.031L6 3.964 4.47 8.557A.5.5 0 0 1 4 9H.5a.5.5 0 0 1 0-1h3.162l1.808-5.426A.5.5 0 0 1 6 2"/>
            </svg>
          </span>
        </div>
        <div>
          <div class="d-flex align-items-center gap-2 mb-1">
            <span class="rounded-circle bg-success" style="width: 10px; height: 10px;"></span>
            <span class="fs-4 fw-bold text-dark text-capitalize">{{status}}</span>
          </div>
          <span class="small text-secondary">Servicio activo y respondiendo</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Uptime -->
  <div class="col-12 col-md-4">
    <div class="card border-0 shadow-sm rounded-4 h-100">
      <div class="card-body p-3 p-sm-4 d-flex flex-column justify-content-between">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <span class="text-secondary small fw-medium">Tiempo activo</span>
          <span class="p-2 rounded-3 bg-primary-subtle text-primary d-inline-flex">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-stopwatch" viewBox="0 0 16 16">
              <path d="M6.5 0a.5.5 0 0 0 0 1H7v1.07A7.001 7.001 0 0 0 8 16a7 7 0 0 0 5.29-11.584l.71-.708 1.414 1.414a.5.5 0 1 0 .707-.707l-2.12-2.122a.5.5 0 0 0-.707 0l-.71.708A7 7 0 0 0 9 2.07V1h.5a.5.5 0 0 0 0-1zm2 3a6 6 0 1 1 0 12 6 6 0 0 1 0-12"/>
              <path d="M7.5 5.5v4.207l2.854 2.853a.5.5 0 0 0 .708-.707L8.5 9.293V5.5a.5.5 0 0 0-1 0"/>
            </svg>
          </span>
        </div>
        <div>
          <div class="fs-4 fw-bold text-dark mb-1 font-monospace">{{uptime}} <span class="fs-6 fw-normal text-secondary">seg</span></div>
          <span class="small text-secondary">Desde el último despliegue/reinicio</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Marca de tiempo -->
  <div class="col-12 col-md-4">
    <div class="card border-0 shadow-sm rounded-4 h-100">
      <div class="card-body p-3 p-sm-4 d-flex flex-column justify-content-between">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <span class="text-secondary small fw-medium">Última lectura</span>
          <span class="p-2 rounded-3 bg-info-subtle text-info-emphasis d-inline-flex">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-clock-history" viewBox="0 0 16 16">
              <path d="M8.515 1.019A7 7 0 0 0 8 1V0a8 8 0 0 1 .589.022zm2.004.45a7 7 0 0 0-.985-.299l.219-.976q.576.129 1.126.342zm1.37.71a7 7 0 0 0-.439-.27l.493-.87a8 8 0 0 1 .979.654l-.615.789a7 7 0 0 0-.418-.302zm1.834 1.79a7 7 0 0 0-.653-.796l.724-.69q.406.429.747.91zm.744 1.352a7 7 0 0 0-.214-.468l.893-.45a8 8 0 0 1 .45 1.088l-.95.313a7 7 0 0 0-.179-.483m.53 2.507a7 7 0 0 0-.1-1.025l.985-.17q.1.58.116 1.17zm-.131 1.538q.05-.254.084-.51l.992.115a8 8 0 0 1-.168 1.132l-.968-.284q.028-.225.06-.453m-1.02 2.572q.292-.459.518-.95l.92.399a8 8 0 0 1-.684 1.258l-.754-.707"/>
              <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71z"/>
            </svg>
          </span>
        </div>
        <div>
          <div class="fs-6 fw-bold text-dark mb-1 font-monospace text-break">{{timestamp}}</div>
          <span class="small text-secondary">Sincronización del servidor</span>
        </div>
      </div>
    </div>
  </div>
</div>