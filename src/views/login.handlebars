<!-- Encabezado responsivo -->
<header class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 pb-3 mb-4 border-bottom">
  <div>
    <span class="badge bg-primary text-white rounded-pill px-3 py-1 mb-2 fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.5px; text-transform: uppercase;">Portal de Acceso</span>
    <h1 class="h3 fw-bold mb-1 text-dark">{{#if isRegister}}Crear cuenta{{else}}Iniciar sesión{{/if}}</h1>
    <p class="text-secondary small mb-0">{{#if isRegister}}Ingresa tus datos para registrarte en la plataforma.{{else}}Introduce tus credenciales para ingresar al sistema.{{/if}}</p>
  </div>
  <div class="badge bg-white text-dark border shadow-sm rounded-pill px-3 py-2 fs-6 align-self-stretch align-self-sm-auto text-center">
    <span class="fw-bold">Estado:</span> Sistema en línea
  </div>
</header>

{{#if error}}
<div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
  <div class="d-flex align-items-center gap-2">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-exclamation-triangle-fill flex-shrink-0" viewBox="0 0 16 16">
      <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
    </svg>
    <div class="small fw-semibold">{{error}}</div>
  </div>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
{{/if}}

{{#if success}}
<div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
  <div class="d-flex align-items-center gap-2">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-check-circle-fill flex-shrink-0" viewBox="0 0 16 16">
      <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
    </svg>
    <div class="small fw-semibold">{{success}}</div>
  </div>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
{{/if}}

<main class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-5">
    <div class="card border border-light-subtle shadow-sm rounded-3 bg-white">
      <div class="card-body p-4">
        
        {{#if isRegister}}
          <!-- Formulario: Agregar Usuario (Registro) -->
          <h2 class="h5 fw-bold text-dark border-bottom pb-3 mb-3">Nuevo usuario</h2>
          
          <form id="register-form" method="POST" action="/registro">
            <!-- Campo Nombre Completo -->
            <div class="mb-3 text-start">
              <label class="form-label fw-bold text-dark small mb-1" for="nombre">Nombre completo</label>
              <input 
                type="text" 
                class="form-control" 
                id="nombre" 
                name="nombre" 
                placeholder="Ej. Juan Pérez" 
                autocomplete="name" 
                required
                style="color: #111827 !important; background-color: #ffffff !important; font-size: 0.95rem; line-height: 1.5; padding: 0.6rem 0.85rem; border: 1px solid #ced4da;"
              >
            </div>

            <!-- Campo Correo -->
            <div class="mb-3 text-start">
              <label class="form-label fw-bold text-dark small mb-1" for="email">Correo electrónico</label>
              <input 
                type="email" 
                class="form-control" 
                id="email" 
                name="email" 
                placeholder="nombre@ejemplo.com" 
                autocomplete="email" 
                required
                style="color: #111827 !important; background-color: #ffffff !important; font-size: 0.95rem; line-height: 1.5; padding: 0.6rem 0.85rem; border: 1px solid #ced4da;"
              >
            </div>

            <!-- Campo Ciudad -->
            <div class="mb-3 text-start">
              <label class="form-label fw-bold text-dark small mb-1" for="ciudad">Ciudad</label>
              <input 
                type="text" 
                class="form-control" 
                id="ciudad" 
                name="ciudad" 
                placeholder="Ej. Santiago" 
                autocomplete="address-level2" 
                required
                style="color: #111827 !important; background-color: #ffffff !important; font-size: 0.95rem; line-height: 1.5; padding: 0.6rem 0.85rem; border: 1px solid #ced4da;"
              >
            </div>

            <!-- Campo Contraseña -->
            <div class="mb-4 text-start">
              <label class="form-label fw-bold text-dark small mb-1" for="password">Contraseña</label>
              <input 
                type="password" 
                class="form-control" 
                id="password" 
                name="password" 
                placeholder="••••••••" 
                autocomplete="new-password" 
                required
                style="color: #111827 !important; background-color: #ffffff !important; font-size: 0.95rem; line-height: 1.5; padding: 0.6rem 0.85rem; border: 1px solid #ced4da;"
              >
            </div>

            <!-- Acciones -->
            <div class="d-grid gap-2">
              <button class="btn btn-dark py-2 fw-semibold shadow-sm" type="submit">
                Registrar cuenta
              </button>
              <a class="btn btn-outline-secondary py-2" href="/login">
                Volver a iniciar sesión
              </a>
            </div>
          </form>

        {{else}}
          <!-- Formulario: Iniciar Sesión -->
          <h2 class="h5 fw-bold text-dark border-bottom pb-3 mb-3">Acceso al sistema</h2>

          <form id="login-form" method="POST" action="/login">
            <!-- Campo Correo -->
            <div class="mb-3 text-start">
              <label class="form-label fw-bold text-dark small mb-1" for="email">Correo electrónico</label>
              <input 
                type="email" 
                class="form-control" 
                id="email" 
                name="email" 
                placeholder="nombre@ejemplo.com" 
                autocomplete="username" 
                required
                style="color: #111827 !important; background-color: #ffffff !important; font-size: 0.95rem; line-height: 1.5; padding: 0.6rem 0.85rem; border: 1px solid #ced4da;"
              >
            </div>

            <!-- Campo Contraseña -->
            <div class="mb-4 text-start">
              <label class="form-label fw-bold text-dark small mb-1" for="password">Contraseña</label>
              <input 
                type="password" 
                class="form-control" 
                id="password" 
                name="password" 
                placeholder="••••••••" 
                autocomplete="current-password" 
                required
                style="color: #111827 !important; background-color: #ffffff !important; font-size: 0.95rem; line-height: 1.5; padding: 0.6rem 0.85rem; border: 1px solid #ced4da;"
              >
            </div>

            <!-- Acciones -->
            <div class="d-grid gap-2">
              <button class="btn btn-dark py-2 fw-semibold shadow-sm" type="submit">
                Iniciar sesión
              </button>
              <a class="btn btn-outline-secondary py-2" href="/login?modo=registro">
                Agregar usuario nuevo
              </a>
            </div>
          </form>
        {{/if}}

      </div>
    </div>
  </div>
</main>