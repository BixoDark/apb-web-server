<!-- Encabezado responsivo -->
<header class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 pb-3 mb-4 border-bottom">
  <div>
    <span class="badge bg-primary text-white rounded-pill px-3 py-1 mb-2 fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.5px; text-transform: uppercase;">Directorio</span>
    <h1 class="h3 fw-bold mb-1 text-dark">Usuarios</h1>
    <p class="text-secondary small mb-0">Administra los datos y la información salarial del equipo.</p>
  </div>
  <div class="badge bg-white text-dark border shadow-sm rounded-pill px-3 py-2 fs-6 align-self-stretch align-self-sm-auto text-center">
    <span class="fw-bold">{{users.length}}</span> registrados
  </div>
</header>

{{#if error}}
<div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
  <div class="d-flex align-items-center gap-2">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-exclamation-triangle-fill flex-shrink-0" viewBox="0 0 16 16">
      <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
    </svg>
    <div class="small fw-semibold">{{error}}</div>
  </div>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
{{/if}}

<main class="row g-4">
  <!-- Columna Formulario -->
  <aside class="col-12 col-lg-4 {{#if editingUser}}order-first{{else}}order-last order-lg-first{{/if}}">
    <div class="card border border-light-subtle shadow-sm rounded-3 bg-white">
      <div class="card-body p-4">
        <h2 class="h5 fw-bold text-dark border-bottom pb-3 mb-3">
          {{#if editingUser}}Editar usuario{{else}}Agregar usuario{{/if}}
        </h2>

        <form id="user-form" method="POST" action="{{#if editingUser}}/usuarios/{{editingUser.id}}/editar{{else}}/usuarios{{/if}}" data-user-id="{{editingUser.id}}">
          <!-- Campo Nombre -->
          <div class="mb-3 text-start">
            <label class="form-label fw-bold text-dark small mb-1" for="nombre">Nombre</label>
            <input 
              type="text" 
              class="form-control" 
              id="nombre" 
              name="nombre" 
              placeholder="Ej. Juan" 
              value="{{editingUser.nombre}}" 
              autocomplete="given-name" 
              required
              style="color: #111827 !important; background-color: #ffffff !important; font-size: 0.95rem; line-height: 1.5; padding: 0.6rem 0.85rem; border: 1px solid #ced4da;"
            >
          </div>

          <!-- Campo Apellido -->
          <div class="mb-3 text-start">
            <label class="form-label fw-bold text-dark small mb-1" for="apellido">Apellido</label>
            <input 
              type="text" 
              class="form-control" 
              id="apellido" 
              name="apellido" 
              placeholder="Ej. Pérez" 
              value="{{editingUser.apellido}}" 
              autocomplete="family-name" 
              required
              style="color: #111827 !important; background-color: #ffffff !important; font-size: 0.95rem; line-height: 1.5; padding: 0.6rem 0.85rem; border: 1px solid #ced4da;"
            >
          </div>

          <!-- Campo Ciudad -->
          <div class="mb-3 text-start">
            <label class="form-label fw-bold text-dark small mb-1" for="lugar">Ciudad</label>
            <input 
              type="text" 
              class="form-control" 
              id="lugar" 
              name="lugar" 
              placeholder="Ej. Santiago" 
              value="{{editingUser.lugar}}" 
              autocomplete="address-level2" 
              required
              style="color: #111827 !important; background-color: #ffffff !important; font-size: 0.95rem; line-height: 1.5; padding: 0.6rem 0.85rem; border: 1px solid #ced4da;"
            >
          </div>

          <!-- Campo Salario -->
          <div class="mb-4 text-start">
            <label class="form-label fw-bold text-dark small mb-1" for="salario">Salario ($)</label>
            <input 
              type="number" 
              class="form-control" 
              id="salario" 
              name="salario" 
              inputmode="decimal" 
              min="0" 
              step="0.01" 
              placeholder="Ej. 1200000" 
              value="{{editingUser.salario}}" 
              required
              style="color: #111827 !important; background-color: #ffffff !important; font-size: 0.95rem; line-height: 1.5; padding: 0.6rem 0.85rem; border: 1px solid #ced4da;"
            >
          </div>

          <!-- Botones -->
          <div class="d-grid gap-2">
            <button class="btn btn-dark py-2 fw-semibold shadow-sm" type="submit">
              {{#if editingUser}}Guardar cambios{{else}}Agregar usuario{{/if}}
            </button>
            {{#if editingUser}}
            <a class="btn btn-outline-secondary py-2" href="/usuarios">Cancelar edición</a>
            {{/if}}
          </div>
        </form>
      </div>
    </div>
  </aside>

  <!-- Columna Lista de Usuarios -->
  <section class="col-12 col-lg-8">
    <div class="card border border-light-subtle shadow-sm rounded-3 bg-white">
      <div class="card-header bg-white border-bottom p-3 px-sm-4 d-flex justify-content-between align-items-center">
        <h2 class="h6 fw-bold mb-0 text-dark">Personal registrado</h2>
        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle rounded-pill px-2 py-1 small">Auditoría activa</span>
      </div>

      <div class="card-body p-3 p-sm-4">
        <div id="user-list">
          {{#if users.length}}
            <div class="d-flex flex-column gap-2">
              {{#each users}}
              <article class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 p-3 rounded-2 border border-light-subtle bg-white shadow-xs">
                <!-- Información usuario -->
                <div class="d-flex align-items-center gap-3 w-100 w-sm-auto">
                  <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold shadow-sm flex-shrink-0" style="width: 44px; height: 44px; min-width: 44px; font-size: 0.9rem;">
                    {{nombre.[0]}}{{apellido.[0]}}
                  </div>
                  <div class="text-truncate">
                    <h3 class="h6 fw-bold mb-1 text-dark text-truncate">{{nombre}} {{apellido}}</h3>
                    <div class="small text-secondary d-flex flex-wrap align-items-center gap-2">
                      <span class="text-body-secondary">{{lugar}}</span>
                      <span>•</span>
                      <span class="fw-bold text-dark">${{salario}}</span>
                      <span>•</span>
                      <span class="badge bg-light text-secondary border font-monospace py-1 px-2">ID: {{id}}</span>
                    </div>
                  </div>
                </div>

                <!-- Botones Acciones -->
                <div class="d-flex gap-2 w-100 w-sm-auto justify-content-end border-top pt-2 pt-sm-0 border-sm-top-0">
                  <a class="btn btn-sm btn-outline-secondary px-3 py-1 flex-fill flex-sm-grow-0 text-center" href="/usuarios?editar={{id}}">
                    Editar
                  </a>
                  <form method="POST" action="/usuarios/{{id}}/eliminar" data-user-id="{{id}}" class="m-0 flex-fill flex-sm-grow-0">
                    <button class="btn btn-sm btn-outline-danger px-3 py-1 w-100" type="submit">
                      Eliminar
                    </button>
                  </form>
                </div>
              </article>
              {{/each}}
            </div>
          {{else}}
            <div class="text-center py-5">
              <p class="text-secondary small mb-0">Todavía no hay usuarios registrados. Agrega el primero desde el formulario.</p>
            </div>
          {{/if}}
        </div>
      </div>
    </div>
  </section>
</main>