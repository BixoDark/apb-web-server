<header class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 pb-3 mb-4 border-bottom">
  <div>
    <span class="badge bg-secondary text-white rounded-pill px-3 py-1 mb-2 fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.5px; text-transform: uppercase;">Cuenta</span>
    <h1 class="h3 fw-bold mb-1 text-dark">Mi Perfil</h1>
    <p class="text-secondary small mb-0">Consulta y actualiza tu información personal registrada.</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/usuarios" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-2">Volver al Directorio</a>
    <a href="/logout" class="btn btn-danger btn-sm rounded-pill px-3 py-2">Cerrar Sesión</a>
  </div>
</header>

{{#if success}}
<div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
  <div class="small fw-semibold">{{success}}</div>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
{{/if}}

{{#if error}}
<div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
  <div class="small fw-semibold">{{error}}</div>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
{{/if}}

<main class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-6">
    <div class="card border border-light-subtle shadow-sm rounded-3 bg-white">
      <div class="card-body p-4">
        
        <form method="POST" action="/perfil">
          <!-- Nombre -->
          <div class="mb-3 text-start">
            <label class="form-label fw-bold text-dark small mb-1" for="nombre">Nombre</label>
            <input type="text" class="form-control" id="nombre" name="nombre" value="{{user.nombre}}" required
                   style="color: #111827 !important; background-color: #ffffff !important; font-size: 0.95rem; border: 1px solid #ced4da;">
          </div>

          <!-- Apellido -->
          <div class="mb-3 text-start">
            <label class="form-label fw-bold text-dark small mb-1" for="apellido">Apellido</label>
            <input type="text" class="form-control" id="apellido" name="apellido" value="{{user.apellido}}" required
                   style="color: #111827 !important; background-color: #ffffff !important; font-size: 0.95rem; border: 1px solid #ced4da;">
          </div>

          <!-- Correo -->
          <div class="mb-3 text-start">
            <label class="form-label fw-bold text-dark small mb-1" for="email">Correo electrónico</label>
            <input type="email" class="form-control" id="email" name="email" value="{{user.email}}"
                   style="color: #111827 !important; background-color: #ffffff !important; font-size: 0.95rem; border: 1px solid #ced4da;">
          </div>

          <!-- Ciudad -->
          <div class="mb-3 text-start">
            <label class="form-label fw-bold text-dark small mb-1" for="lugar">Ciudad / Ubicación</label>
            <input type="text" class="form-control" id="lugar" name="lugar" value="{{user.lugar}}" required
                   style="color: #111827 !important; background-color: #ffffff !important; font-size: 0.95rem; border: 1px solid #ced4da;">
          </div>

          <!-- Salario propio -->
          <div class="mb-3 text-start">
            <label class="form-label fw-bold text-dark small mb-1" for="salario">Salario</label>
            <input type="number" class="form-control" id="salario" name="salario" value="{{user.salario}}" min="0" step="0.01" required
                   style="color: #111827 !important; background-color: #ffffff !important; font-size: 0.95rem; border: 1px solid #ced4da;">
            <div class="form-text text-muted small">ingrese su salario.</div>
          </div>

          <!-- Cambio de Contraseña -->
          <div class="mb-4 text-start">
            <label class="form-label fw-bold text-dark small mb-1" for="password">Nueva contraseña</label>
            <input type="password" class="form-control" id="password" name="password" placeholder="Dejar en blanco para mantener la actual"
                   style="color: #111827 !important; background-color: #ffffff !important; font-size: 0.95rem; border: 1px solid #ced4da;">
          </div>

          <!-- Acciones -->
          <div class="d-grid gap-2">
            <button class="btn btn-dark py-2 fw-semibold shadow-sm" type="submit">
              Guardar cambios
            </button>
          </div>
        </form>

      </div>
    </div>
  </div>
</main>